
#1st Step
x1,y1 = 2,3
x2,y2 = 13,9

#2nd Step
dx = x2-x1
dy = y2-y1


#3rd Step
steps = max(abs(dx), abs(dy))

#4th Step
x_inc = dx/steps
y_inc = dy/steps
x, y = x1,y1

#5th Step
x_point = []
y_point = []

#6th Step
for i in range(steps):
  x_point.append(round(x))
  y_point.append(round(y))

  x = x+x_inc
  y = y+y_inc

#7th step
plt.plot(x_point, y_point, marker="o", color="blue", linestyle="-")
plt.title("DDA Line Drawing Algorithm")
plt.xlabel("X-Axis")
plt.ylabel("Y-Axis")
plt.grid()
plt.show()
